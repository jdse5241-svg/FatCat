diff --git a/windows/Cursors/FatCat-Cursor.ps1 b/windows/Cursors/FatCat-Cursor.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..125ff48384831536b205a70325b32d210fdba0fd
--- /dev/null
+++ b/windows/Cursors/FatCat-Cursor.ps1
@@ -0,0 +1,235 @@
+﻿param(
+    [ValidateSet('Apply', 'Restore')]
+    [string]$Mode
+)
+
+$ErrorActionPreference = 'Stop'
+$installDir = Join-Path ([Environment]::GetFolderPath('LocalApplicationData')) 'FatCatCursorEdition'
+$cursorDir = Join-Path $installDir 'Cursors'
+$logFile = Join-Path $installDir 'Setup.log'
+$backupFile = Join-Path $installDir 'Cursor-Backup.json'
+$previousNames = @(('Sweet' + 'Cat'), ('Kuro' + 'Cat'))
+$cursorKey = 'Control Panel\Cursors'
+$roles = [ordered]@{
+    Arrow = 'FatCat-Normal.cur'
+    Wait = 'FatCat-Busy.ani'
+    IBeam = 'FatCat-Text.cur'
+}
+
+function Get-CursorValues($Key) {
+    $values = @{}
+    $existing = $Key.GetValueNames()
+    foreach ($role in $roles.Keys) {
+        $present = $existing -contains $role
+        $kind = 'String'
+        $value = $null
+        if ($present) {
+            $kind = $Key.GetValueKind($role).ToString()
+            if ($kind -notin @('String', 'ExpandString')) {
+                throw "The existing Windows cursor value $role has an unexpected type."
+            }
+            $value = $Key.GetValue($role, $null, [Microsoft.Win32.RegistryValueOptions]::DoNotExpandEnvironmentNames)
+        }
+        $values[$role] = @{ Present = $present; Kind = $kind; Value = $value }
+    }
+    return $values
+}
+
+function Set-CursorValues($Key, $Values) {
+    foreach ($role in $Values.Keys) {
+        $entry = $Values[$role]
+        if ($entry.Present) {
+            $Key.SetValue($role, [string]$entry.Value, [Microsoft.Win32.RegistryValueKind]$entry.Kind)
+        } else {
+            $Key.DeleteValue($role, $false)
+        }
+    }
+}
+
+function Read-CursorBackup($File) {
+    $data = Get-Content -LiteralPath $File -Raw | ConvertFrom-Json
+    if ($data.Version -ne 1) { throw 'The cursor backup has an unsupported format.' }
+    $values = @{}
+    foreach ($role in $roles.Keys) {
+        $entry = $data.Values.$role
+        if ($null -eq $entry -or $entry.Present -isnot [bool] -or $entry.Kind -notin @('String', 'ExpandString') -or ($entry.Present -and $entry.Value -isnot [string])) {
+            throw "The cursor backup is missing a valid value for $role."
+        }
+        $values[$role] = $entry
+    }
+    return $values
+}
+
+function Save-CursorBackup($Values) {
+    $temporary = Join-Path $installDir ('Cursor-Backup-' + [guid]::NewGuid().ToString() + '.tmp')
+    try {
+        $json = @{ Version = 1; Values = $Values } | ConvertTo-Json -Depth 4
+        [IO.File]::WriteAllText($temporary, $json)
+        if ([IO.File]::Exists($backupFile)) {
+            [IO.File]::Replace($temporary, $backupFile, [NullString]::Value)
+        } else {
+            [IO.File]::Move($temporary, $backupFile)
+        }
+    } finally {
+        if ([IO.File]::Exists($temporary)) { [IO.File]::Delete($temporary) }
+    }
+}
+
+function Initialize-CursorInterop {
+    if (-not ('FatCat.CursorInteropV2' -as [type])) {
+        Add-Type -Namespace FatCat -Name CursorInteropV2 -MemberDefinition @'
+[System.Runtime.InteropServices.DllImport("user32.dll", EntryPoint = "SystemParametersInfoW", ExactSpelling = true, SetLastError = true)]
+public static extern bool Reload(uint action, uint uParam, System.IntPtr value, uint flags);
+
+[System.Runtime.InteropServices.DllImport("user32.dll", EntryPoint = "LoadCursorFromFileW", ExactSpelling = true, CharSet = System.Runtime.InteropServices.CharSet.Unicode, SetLastError = true)]
+public static extern System.IntPtr Load(string fileName);
+
+[System.Runtime.InteropServices.DllImport("user32.dll", SetLastError = true)]
+public static extern bool SetSystemCursor(System.IntPtr cursor, uint id);
+
+[System.Runtime.InteropServices.DllImport("user32.dll", SetLastError = true)]
+public static extern bool DestroyCursor(System.IntPtr cursor);
+
+public static int CheckFile(string fileName) {
+    var cursor = Load(fileName);
+    if (cursor == System.IntPtr.Zero) {
+        int error = System.Runtime.InteropServices.Marshal.GetLastWin32Error();
+        return error != 0 ? error : -1;
+    }
+    DestroyCursor(cursor);
+    return 0;
+}
+
+public static int UseFile(string fileName, uint id) {
+    var cursor = Load(fileName);
+    if (cursor == System.IntPtr.Zero) {
+        int error = System.Runtime.InteropServices.Marshal.GetLastWin32Error();
+        return error != 0 ? error : -1;
+    }
+    if (SetSystemCursor(cursor, id)) return 0;
+    int failure = System.Runtime.InteropServices.Marshal.GetLastWin32Error();
+    return failure != 0 ? failure : -1;
+}
+'@
+    }
+}
+
+function Update-SystemCursors($Values) {
+    Initialize-CursorInterop
+    if ($null -eq $Values) {
+        if (-not [FatCat.CursorInteropV2]::Reload(0x0057, 0, [IntPtr]::Zero, 0)) {
+            throw 'Windows 未能重新加载原有指针。'
+        }
+        return
+    }
+
+    $ids = @{ Arrow = 32512; Wait = 32514; IBeam = 32513 }
+    foreach ($role in $roles.Keys) {
+        $code = [FatCat.CursorInteropV2]::UseFile($Values[$role].Value, $ids[$role])
+        if ($code -ne 0) {
+            throw "Windows 未能启用指针 $role（错误码 $code）。"
+        }
+    }
+}
+
+function Select-CursorFile($Role) {
+    Initialize-CursorInterop
+    $file = Join-Path $cursorDir $roles[$Role]
+    $code = [FatCat.CursorInteropV2]::CheckFile($file)
+    if ($code -ne 0 -and $Role -eq 'Wait') {
+        Write-Warning "Windows 无法载入忙碌动画（错误码 $code），改用静态忙碌指针。"
+        $file = Join-Path $cursorDir 'FatCat-Busy.cur'
+        $code = [FatCat.CursorInteropV2]::CheckFile($file)
+    }
+    if ($code -ne 0) {
+        throw "Windows 无法载入指针 $Role（错误码 $code）：$file"
+    }
+    return $file
+}
+
+function Test-InstalledCursor($Role, $Value, $Directory = $cursorDir, $Brand = 'FatCat') {
+    $file = $Brand + $roles[$Role].Substring('FatCat'.Length)
+    if ($Value -eq (Join-Path $Directory $file)) { return $true }
+    return $Role -eq 'Wait' -and $Value -eq (Join-Path $Directory ($Brand + '-Busy.cur'))
+}
+
+function Set-CursorSkin([bool]$Restore) {
+    $key = [Microsoft.Win32.Registry]::CurrentUser.CreateSubKey($cursorKey)
+    try {
+        $current = Get-CursorValues $key
+        $hasBackup = Test-Path -LiteralPath $backupFile -PathType Leaf
+        $original = if ($hasBackup) { Read-CursorBackup $backupFile } else { $current.Clone() }
+        $previousBackups = @{}
+        $desired = @{}
+        foreach ($role in $roles.Keys) {
+            $isCurrent = $current[$role].Present -and (Test-InstalledCursor $role $current[$role].Value)
+            $isPrevious = $false
+            foreach ($name in $previousNames) {
+                $previousDir = Join-Path (Split-Path -Parent $installDir) ($name + 'CursorEdition')
+                $previousCursorDir = Join-Path $previousDir 'Cursors'
+                if (-not $current[$role].Present -or
+                    -not (Test-InstalledCursor $role $current[$role].Value $previousCursorDir $name)) { continue }
+                if (-not $previousBackups.ContainsKey($name)) {
+                    $previousBackupFile = Join-Path $previousDir 'Cursor-Backup.json'
+                    if (-not (Test-Path -LiteralPath $previousBackupFile -PathType Leaf)) {
+                        throw '找不到旧版保存的原指针。可从 Windows 鼠标属性的「指针」页重新选择原来的方案。'
+                    }
+                    $previousBackups[$name] = Read-CursorBackup $previousBackupFile
+                }
+                $original[$role] = $previousBackups[$name][$role]
+                $isPrevious = $true
+                break
+            }
+            if ($isCurrent -and -not $hasBackup) {
+                throw '找不到原指针的备份。可从 Windows 鼠标属性的「指针」页重新选择原来的方案。'
+            }
+            if ($Restore) {
+                if ($isCurrent -or $isPrevious) { $desired[$role] = $original[$role] }
+            } else {
+                if (-not $isCurrent -and -not $isPrevious) { $original[$role] = $current[$role] }
+                $path = Select-CursorFile $role
+                $desired[$role] = @{ Present = $true; Kind = 'ExpandString'; Value = $path }
+            }
+        }
+        if (-not $Restore) { Save-CursorBackup $original }
+        try {
+            Set-CursorValues $key $desired
+            if ($Restore) { Update-SystemCursors $null }
+            else { Update-SystemCursors $desired }
+        } catch {
+            $failure = $_
+            Set-CursorValues $key $current
+            try { Update-SystemCursors } catch { Write-Warning 'Windows could not immediately reload the previous pointers.' }
+            throw $failure
+        }
+        if ($Restore) {
+            if ($hasBackup) { Remove-Item -LiteralPath $backupFile }
+            Write-Host '已恢复安装前的鼠标指针。'
+        } else {
+            Write-Host '已启用小黑猫鼠标指针。'
+        }
+    } finally {
+        $key.Dispose()
+    }
+}
+
+$mutex = [Threading.Mutex]::new($false, 'Local\FatCatCursorEditionSetup')
+$acquired = $false
+$logging = $false
+try {
+    try { $acquired = $mutex.WaitOne(0) }
+    catch [Threading.AbandonedMutexException] { $acquired = $true }
+    if (-not $acquired) { throw '另一个安装或指针设置窗口正在运行。' }
+    New-Item -ItemType Directory -Path $installDir -Force | Out-Null
+    Start-Transcript -LiteralPath $logFile -Append | Out-Null
+    $logging = $true
+    Set-CursorSkin ($Mode -eq 'Restore')
+} catch {
+    Write-Host $_.Exception.Message -ForegroundColor Red
+    if ($logging) { Write-Host "安装日志 $logFile" }
+    exit 1
+} finally {
+    if ($logging) { Stop-Transcript | Out-Null }
+    if ($acquired) { $mutex.ReleaseMutex() }
+    $mutex.Dispose()
+}
