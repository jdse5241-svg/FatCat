diff --git a/windows/src/CursorSkin.hpp b/windows/src/CursorSkin.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..1230ce43481fad3523e4b8c6d79ea064f44c124c
--- /dev/null
+++ b/windows/src/CursorSkin.hpp
@@ -0,0 +1,180 @@
+#pragma once
+
+#include <windows.h>
+#include <shlobj.h>
+#include <string>
+#include "CursorResources.h"
+#include "ProductName.hpp"
+
+class CursorSkin {
+public:
+    bool enabled() const { return overlayEnabled_; }
+    bool installed() const { return installedRoles_ == 3; }
+    bool hasActiveRoles() const { return overlayEnabled_ || installedRoles_ != 0 || previousRoles_ != 0; }
+    bool changing() const { return process_ != nullptr; }
+
+    void refresh() {
+        installedRoles_ = countRoles(dataDirectory(), L"FatCat");
+        previousRoles_ = 0;
+        for (const auto& name : previousProductNames()) {
+            previousRoles_ += countRoles(dataDirectory(name), name);
+        }
+
+        overlayEnabled_ = installedRoles_ > 0 || previousRoles_ > 0;
+        if (readOverlaySelection(settingsKey_, overlayEnabled_)) return;
+        for (const auto& name : previousProductNames()) {
+            if (readOverlaySelection(L"Software\\" + name, overlayEnabled_)) return;
+        }
+    }
+
+    static HCURSOR loadInteractionCursor(const wchar_t* fileName) {
+        const auto directory = dataDirectory();
+        if (directory.empty()) return nullptr;
+        return LoadCursorFromFileW((directory + L"\\Cursors\\" + fileName).c_str());
+    }
+
+    bool startChange(bool apply) {
+        if (changing()) return false;
+        const auto directory = dataDirectory();
+        if (directory.empty() || !ensureDirectory(directory)) return false;
+
+        if (apply && !exportCursors(directory + L"\\Cursors")) return false;
+        const auto setup = directory + L"\\FatCat-Cursor.ps1";
+        if (!exportResource(SWC_CURSOR_SCRIPT, directory, setup)) return false;
+
+        wchar_t system[MAX_PATH] = {};
+        const UINT length = GetSystemDirectoryW(system, MAX_PATH);
+        if (length == 0 || length >= MAX_PATH) return false;
+
+        const std::wstring powershell = std::wstring(system) + L"\\WindowsPowerShell\\v1.0\\powershell.exe";
+        std::wstring command = L"\"" + powershell +
+            L"\" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"" + setup +
+            L"\" -Mode " + (apply ? L"Apply" : L"Restore");
+
+        STARTUPINFOW startup = {};
+        startup.cb = sizeof(startup);
+        PROCESS_INFORMATION process = {};
+        if (!CreateProcessW(powershell.c_str(), command.data(), nullptr, nullptr, FALSE,
+                            CREATE_NO_WINDOW, nullptr, nullptr, &startup, &process)) return false;
+        CloseHandle(process.hThread);
+        requestedEnable_ = apply;
+        process_ = process.hProcess;
+        return true;
+    }
+
+    bool finishChange(DWORD& exitCode) {
+        if (!changing()) return false;
+
+        const DWORD status = WaitForSingleObject(process_, 0);
+        if (status == WAIT_TIMEOUT) return false;
+
+        exitCode = ERROR_GEN_FAILURE;
+        if (status == WAIT_OBJECT_0) GetExitCodeProcess(process_, &exitCode);
+        close();
+        refresh();
+        if (exitCode == ERROR_SUCCESS) {
+            overlayEnabled_ = requestedEnable_;
+            const DWORD selected = requestedEnable_ ? 1 : 0;
+            RegSetKeyValueW(HKEY_CURRENT_USER, settingsKey_, L"CatCursorEnabled",
+                            REG_DWORD, &selected, sizeof(selected));
+        }
+        return true;
+    }
+
+    void close() {
+        if (process_) CloseHandle(process_);
+        process_ = nullptr;
+    }
+
+private:
+    static constexpr const wchar_t* settingsKey_ = L"Software\\FatCat";
+    bool overlayEnabled_ = false;
+    bool requestedEnable_ = false;
+    HANDLE process_ = nullptr;
+    int installedRoles_ = 0;
+    int previousRoles_ = 0;
+
+    static bool readOverlaySelection(const std::wstring& key, bool& enabled) {
+        DWORD selected = 0;
+        DWORD size = sizeof(selected);
+        if (RegGetValueW(HKEY_CURRENT_USER, key.c_str(), L"CatCursorEnabled",
+                         RRF_RT_REG_DWORD, nullptr, &selected, &size) != ERROR_SUCCESS) return false;
+        enabled = selected != 0;
+        return true;
+    }
+
+    static std::wstring dataDirectory(const std::wstring& name = L"FatCat") {
+        wchar_t local[MAX_PATH] = {};
+        if (FAILED(SHGetFolderPathW(nullptr, CSIDL_LOCAL_APPDATA, nullptr, SHGFP_TYPE_CURRENT, local))) return {};
+        return std::wstring(local) + L"\\" + name + L"CursorEdition";
+    }
+
+    static bool ensureDirectory(const std::wstring& path) {
+        if (CreateDirectoryW(path.c_str(), nullptr)) return true;
+        const DWORD attributes = GetFileAttributesW(path.c_str());
+        return attributes != INVALID_FILE_ATTRIBUTES && (attributes & FILE_ATTRIBUTE_DIRECTORY) != 0;
+    }
+
+    static bool exportResource(int id, const std::wstring& directory, const std::wstring& path) {
+        const HMODULE module = GetModuleHandleW(nullptr);
+        const HRSRC resource = FindResourceW(module, MAKEINTRESOURCEW(id), RT_RCDATA);
+        if (!resource) return false;
+
+        const HGLOBAL loaded = LoadResource(module, resource);
+        const DWORD size = SizeofResource(module, resource);
+        const void* bytes = loaded ? LockResource(loaded) : nullptr;
+        if (!bytes || size == 0) return false;
+
+        wchar_t temporary[MAX_PATH] = {};
+        if (!GetTempFileNameW(directory.c_str(), L"KRC", 0, temporary)) return false;
+        const HANDLE file = CreateFileW(temporary, GENERIC_WRITE, 0, nullptr, TRUNCATE_EXISTING,
+                                        FILE_ATTRIBUTE_NORMAL, nullptr);
+        bool written = false;
+        if (file != INVALID_HANDLE_VALUE) {
+            DWORD count = 0;
+            written = WriteFile(file, bytes, size, &count, nullptr) && count == size;
+            CloseHandle(file);
+        }
+
+        if (written && MoveFileExW(temporary, path.c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH)) return true;
+        DeleteFileW(temporary);
+        return false;
+    }
+
+    static bool exportCursors(const std::wstring& directory) {
+        if (!ensureDirectory(directory)) return false;
+
+        struct CursorFile { int resource; const wchar_t* name; };
+        constexpr CursorFile cursors[] = {
+            {SWC_CURSOR_NORMAL, L"FatCat-Normal.cur"},
+            {SWC_CURSOR_TEXT, L"FatCat-Text.cur"},
+            {SWC_CURSOR_BUSY_ANIMATED, L"FatCat-Busy.ani"},
+            {SWC_CURSOR_BUSY, L"FatCat-Busy.cur"},
+            {SWC_CURSOR_HOVER, L"FatCat-Cat-Hover.cur"},
+            {SWC_CURSOR_PRESSED_ANIMATED, L"FatCat-Pressed.ani"},
+            {SWC_CURSOR_PRESSED, L"FatCat-Pressed.cur"}
+        };
+        for (const auto& cursor : cursors) {
+            if (!exportResource(cursor.resource, directory, directory + L"\\" + cursor.name)) return false;
+        }
+        return true;
+    }
+
+    static int countRoles(const std::wstring& directory, const std::wstring& name) {
+        if (directory.empty()) return 0;
+        const auto prefix = directory + L"\\Cursors\\" + name;
+        int roles = 0;
+        if (matchesFile(L"Arrow", prefix + L"-Normal.cur")) ++roles;
+        if (matchesFile(L"Wait", prefix + L"-Busy.ani") || matchesFile(L"Wait", prefix + L"-Busy.cur")) ++roles;
+        if (matchesFile(L"IBeam", prefix + L"-Text.cur")) ++roles;
+        return roles;
+    }
+
+    static bool matchesFile(const wchar_t* role, const std::wstring& file) {
+        wchar_t value[MAX_PATH] = {};
+        DWORD size = sizeof(value);
+        const LSTATUS status = RegGetValueW(HKEY_CURRENT_USER, L"Control Panel\\Cursors", role,
+                                            RRF_RT_REG_SZ | RRF_RT_REG_EXPAND_SZ | RRF_NOEXPAND, nullptr, value, &size);
+        return status == ERROR_SUCCESS && _wcsicmp(value, file.c_str()) == 0;
+    }
+};
