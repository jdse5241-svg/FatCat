diff --git a/windows/CMakeLists.txt b/windows/CMakeLists.txt
index 33f7497702ba6d5350ed24798d056b4cbedf0791..d6f468010d960b4634ca404a9760639802d52898 100644
--- a/windows/CMakeLists.txt
+++ b/windows/CMakeLists.txt
@@ -1,19 +1,21 @@
 cmake_minimum_required(VERSION 3.20)
-project(KuroCat LANGUAGES CXX)
+project(FatCat LANGUAGES CXX RC)
 
 set(CMAKE_CXX_STANDARD 17)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
 
-add_executable(KuroCat WIN32
+add_executable(FatCat WIN32
     src/main.cpp
     app.manifest
+    cursors.rc
 )
 
-target_compile_definitions(KuroCat PRIVATE UNICODE _UNICODE NOMINMAX)
+target_include_directories(FatCat PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}")
+target_compile_definitions(FatCat PRIVATE UNICODE _UNICODE NOMINMAX)
 if(MSVC)
-    target_compile_options(KuroCat PRIVATE /O2 /utf-8 /EHsc /W3 /MT)
+    target_compile_options(FatCat PRIVATE /O2 /utf-8 /EHsc /W3 /MT)
 else()
-    target_compile_options(KuroCat PRIVATE -O2 -municode)
+    target_compile_options(FatCat PRIVATE -O2 -municode)
 endif()
 
-target_link_libraries(KuroCat PRIVATE user32 gdi32 gdiplus shell32 advapi32)
+target_link_libraries(FatCat PRIVATE user32 gdi32 gdiplus shell32 advapi32)
