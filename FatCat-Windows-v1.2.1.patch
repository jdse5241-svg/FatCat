new file mode 100644
index 0000000000000000000000000000000000000000..21f3148dfc8a9c382fd378bfdd80af5657abab67
--- /dev/null
+++ b/windows/src/PettingReaction.hpp
@@ -0,0 +1,62 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+
+class PettingReaction {
+public:
+    void stroke(double now) {
+        update(now);
+        const double gap = now - lastStroke_;
+        lastStroke_ = now;
+        if (annoyed()) return;
+
+        strokeTime_ = gap <= StrokeGap ? strokeTime_ + gap : 0.0;
+        if (strokeTime_ >= PettingLimit) {
+            annoyedSince_ = now;
+            strokeTime_ = 0.0;
+        }
+    }
+
+    void update(double now) {
+        if (now - lastStroke_ >= ReleaseGap &&
+            annoyed() && now - annoyedSince_ >= PopDuration + WagDuration) {
+            annoyedSince_ = -1.0;
+        }
+    }
+
+    bool annoyed() const { return annoyedSince_ >= 0.0; }
+
+    struct TailMotion {
+        float lift = 0.0f;
+        float swing = 0.0f;
+    };
+
+    TailMotion tailMotion(double now) const {
+        if (!annoyed()) return {};
+        const double elapsed = now - annoyedSince_;
+        if (elapsed < 0.0) return {};
+        constexpr double pi = 3.141592653589793;
+
+        if (elapsed < PopDuration) {
+            const double progress = elapsed / PopDuration;
+            const double pulse = std::sin(progress * 3.0 * pi);
+            return {static_cast<float>(pulse * pulse * (1.0 - progress * 0.40)), 0.0f};
+        }
+
+        const double progress = (elapsed - PopDuration) / WagDuration;
+        const double amplitude = 1.0 - std::min(progress, 1.0) * 0.32;
+        return {0.0f, static_cast<float>(std::sin(progress * 4.0 * pi) * amplitude)};
+    }
+
+private:
+    static constexpr double PettingLimit = 2.5;
+    static constexpr double StrokeGap = 0.18;
+    static constexpr double ReleaseGap = 0.65;
+    static constexpr double PopDuration = 0.33;
+    static constexpr double WagDuration = 0.88;
+
+    double lastStroke_ = -1.0;
+    double strokeTime_ = 0.0;
+    double annoyedSince_ = -1.0;
+};
