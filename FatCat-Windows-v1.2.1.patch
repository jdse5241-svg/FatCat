diff --git a/windows/build.bat b/windows/build.bat
index 1001fd543912b9d59612f25b468ade34d616d6be..6ac295c34f0df50f176a269f4de84ddfc4524a68 100644
--- a/windows/build.bat
+++ b/windows/build.bat
@@ -2,27 +2,32 @@
 setlocal
 cd /d "%~dp0"
 
-echo ==> Building KuroCat.exe (Windows native C++17 / Win32 + GDI+ + Raw Input)...
+echo ==> Building FatCat.exe (Windows native C++17 / Win32 + GDI+ + Raw Input)...
 
 where cl >nul 2>nul
 if %ERRORLEVEL%==0 (
+    rc /nologo /fo cursors.res cursors.rc
+    if errorlevel 1 exit /b 1
     cl /nologo /std:c++17 /O2 /MT /EHsc /utf-8 /DUNICODE /D_UNICODE ^
-       /W3 src\main.cpp /Fe:KuroCat.exe ^
+       /W3 src\main.cpp cursors.res /Fe:FatCat.exe ^
        /link /SUBSYSTEM:WINDOWS /MANIFEST:EMBED /MANIFESTINPUT:app.manifest ^
        user32.lib gdi32.lib gdiplus.lib shell32.lib advapi32.lib
-    if %ERRORLEVEL% neq 0 exit /b %ERRORLEVEL%
-    del /q main.obj 2>nul
-    echo ==> Built successfully with MSVC: %~dp0KuroCat.exe
+    if errorlevel 1 exit /b 1
+    del /q main.obj cursors.res 2>nul
+    echo ==> Built successfully with MSVC: %~dp0FatCat.exe
     exit /b 0
 )
 
 where g++ >nul 2>nul
 if %ERRORLEVEL%==0 (
+    windres cursors.rc -O coff -o cursors.o
+    if errorlevel 1 exit /b 1
     g++ -std=c++17 -O2 -mwindows -municode -DUNICODE -D_UNICODE -static ^
-        src\main.cpp -o KuroCat.exe ^
+        src\main.cpp cursors.o -o FatCat.exe ^
         -luser32 -lgdi32 -lgdiplus -lshell32 -ladvapi32
-    if %ERRORLEVEL% neq 0 exit /b %ERRORLEVEL%
-    echo ==> Built successfully with MinGW: %~dp0KuroCat.exe
+    if errorlevel 1 exit /b 1
+    del /q cursors.o
+    echo ==> Built successfully with MinGW: %~dp0FatCat.exe
     exit /b 0
 )
 
